generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
}

// --- NEXTAUTH MODELS ---

model User {
  id            String    @id @default(cuid())
  name          String?
  email         String   @unique
  emailVerified DateTime?
  image         String?
  imagePublicId String?
  password      String?
  role          UserRole  @default(STUDENT)
  accounts      Account[]
  sessions      Session[]

  // Custom relations
  tutorProfile TutorProfile?
  tuitionPosts TuitionPost[]
  applications Application[]
  payments     Payment[]
  passwordResetTokens PasswordResetToken[]

  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
}

enum UserRole {
  STUDENT
  TUTOR
  ADMIN
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String? @db.Text
  access_token      String? @db.Text
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String? @db.Text
  session_state     String?

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

// --- E-TUITION SPECIFIC MODELS ---

model TutorProfile {
  id             String   @id @default(cuid())
  userId         String   @unique
  // If a user has a TutorProfile, their role should be TUTOR (enforced in application logic)
  user           User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  bio            String?
  // NOTE: String[] is kept for now, but may need normalization for scalability later
  subjects       String[]
  experience     String?
  // NOTE: String[] is kept for now, but may need normalization for scalability later
  qualifications String[]
  hourlyRate     Float?
  location       String?
  isVerified     Boolean  @default(false)
  createdAt      DateTime @default(now())
  updatedAt      DateTime @updatedAt
}

model TuitionPost {
  id           String        @id @default(cuid())
  studentId    String
  student      User          @relation(fields: [studentId], references: [id], onDelete: Cascade)
  title        String
  description  String
  subject      String
  grade        String
  salary       Float
  location     String
  status       PostStatus    @default(OPEN)
  applications Application[]
  payment      Payment?
  createdAt    DateTime      @default(now())
  updatedAt    DateTime      @updatedAt
}

enum PostStatus {
  OPEN
  CLOSED
  FILLED
}

model Application {
  id        String      @id @default(cuid())
  postId    String
  post      TuitionPost @relation(fields: [postId], references: [id], onDelete: Cascade)
  tutorId   String
  tutor     User        @relation(fields: [tutorId], references: [id], onDelete: Cascade)
  message   String?
  status    ApplicationStatus @default(PENDING)
  createdAt DateTime    @default(now())

  @@unique([postId, tutorId])
}

enum ApplicationStatus {
  PENDING
  ACCEPTED
  REJECTED
}

model Payment {
  id        String        @id @default(cuid())
  amount    Float
  status    PaymentStatus @default(PENDING)
  stripeId  String?
  postId    String        @unique
  userId    String
  post      TuitionPost   @relation(fields: [postId], references: [id], onDelete: Cascade)
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  createdAt DateTime      @default(now())
}

enum PaymentStatus {
  PENDING
  PAID
  FAILED
}

model PasswordResetToken {
  id        String   @id @default(cuid())
  userId    String
  tokenHash String   @unique
  expiresAt DateTime
  createdAt DateTime @default(now())

  user User @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@index([userId])
}
