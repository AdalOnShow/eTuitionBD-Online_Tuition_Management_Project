# -----------------------------------------------------------------------------
# eTuitionBD environment variables
# Copy this file to `.env` and fill in real values.
# Do NOT commit real secrets to git.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Database (Required)
# Source:
#   Neon dashboard -> Project -> Connection Details -> Pooled connection string
# Example format:
#   postgresql://user:password@host/db?sslmode=require
# -----------------------------------------------------------------------------
DATABASE_URL=""

# -----------------------------------------------------------------------------
# Auth.js / NextAuth (Required in production, recommended in development)
# AUTH_SECRET source:
#   Generate with: openssl rand -base64 32
# AUTH_URL source:
#   Local: http://localhost:3000
#   Production: https://your-domain.com
# -----------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

# Optional override secrets for custom token system.
# If empty, AUTH_SECRET will be used for both.
ACCESS_TOKEN_SECRET=""
REFRESH_TOKEN_SECRET=""

# Access token TTL (seconds). Default: 900 (15 min)
ACCESS_TOKEN_MAX_AGE="900"

# Refresh token TTL (seconds). Default: 2592000 (30 days)
REFRESH_TOKEN_MAX_AGE="2592000"

# -----------------------------------------------------------------------------
# Google OAuth (Required for "Continue with Google")
# Source:
#   Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# Important callback URL:
#   http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Cloudinary upload signing (Required for profile photo upload)
# Source:
#   Cloudinary Dashboard -> API Environment Variables / API Keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""

# Optional convenience variable (not read directly by this codebase right now).
# If you use it elsewhere, keep it synced with the 3 values above:
# CLOUDINARY_URL="cloudinary://<api_key>:<api_secret>@<cloud_name>"
