# -----------------------------------------------------------------------------
# eTuitionBD environment variables
# Copy this file to `.env` and fill in real values.
# Do NOT commit real secrets to git.
# -----------------------------------------------------------------------------

NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# JWT Configuration
# JWT_ACCESS_SECRET: Secret for signing access tokens
# JWT_ACCESS_EXPIRES: Access token expiration (e.g., "1h", "15m")
# JWT_REFRESH_SECRET: Secret for signing refresh tokens
# JWT_REFRESH_EXPIRES: Refresh token expiration (e.g., "7d", "30d")
# -----------------------------------------------------------------------------
JWT_ACCESS_SECRET=""
JWT_ACCESS_EXPIRES="1h"
JWT_REFRESH_SECRET=""
JWT_REFRESH_EXPIRES="7d"

# -----------------------------------------------------------------------------
# App URLs
# NEXT_PUBLIC_DEVELOPMENT_APP_ROOT_URL: Root domain for development
# NEXT_PUBLIC_PRODUCTION_APP_ROOT_URL: Root domain for production
# -----------------------------------------------------------------------------
NEXT_PUBLIC_DEVELOPMENT_APP_ROOT_URL="lvh.me"
NEXT_PUBLIC_PRODUCTION_APP_ROOT_URL="risetogetherbd.shop"
