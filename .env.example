# -----------------------------------------------------------------------------
# eTuitionBD environment variables
# Copy this file to `.env` and fill in real values.
# Do NOT commit real secrets to git.
# -----------------------------------------------------------------------------

# -----------------------------------------------------------------------------
# Auth.js / NextAuth (Required in production, recommended in development)
# AUTH_SECRET source:
#   Generate with: openssl rand -base64 32
# AUTH_URL source:
#   Local: http://localhost:3000
#   Production: https://your-domain.com
# -----------------------------------------------------------------------------
AUTH_SECRET=""
AUTH_URL="http://localhost:3000"

NEXT_PUBLIC_API_URL="http://localhost:3001"

# -----------------------------------------------------------------------------
# Google OAuth (Required for "Continue with Google")
# Source:
#   Google Cloud Console -> APIs & Services -> Credentials -> OAuth Client ID
# Important callback URL:
#   http://localhost:3000/api/auth/callback/google
# -----------------------------------------------------------------------------
GOOGLE_CLIENT_ID=""
GOOGLE_CLIENT_SECRET=""

# -----------------------------------------------------------------------------
# Cloudinary upload signing (Required for profile photo upload)
# Source:
#   Cloudinary Dashboard -> API Environment Variables / API Keys
# -----------------------------------------------------------------------------
CLOUDINARY_CLOUD_NAME=""
CLOUDINARY_API_KEY=""
CLOUDINARY_API_SECRET=""
